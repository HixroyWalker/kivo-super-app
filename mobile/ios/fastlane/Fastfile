default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    setup_ci

    api_key = nil
    if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"] && !ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"].empty?
      api_key = app_store_connect_api_key(
        key_id: ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"],
        issuer_id: ENV["APP_STORE_CONNECT_API_KEY_ISSUER_ID"],
        key_content: ENV["APP_STORE_CONNECT_API_KEY_KEY"],
        is_key_content_base64: true
      )
    end

    if ENV["IOS_CERTIFICATE_P12_BASE64"] && !ENV["IOS_CERTIFICATE_P12_BASE64"].empty?
      p12_path = File.expand_path("/tmp/distribution.p12")
      File.open(p12_path, "wb") do |f|
        f.write(Base64.decode64(ENV["IOS_CERTIFICATE_P12_BASE64"]))
      end
      import_certificate(
        certificate_path: p12_path,
        certificate_password: ENV["IOS_CERTIFICATE_PASSWORD"] || "",
        keychain_name: "fastlane_tmp_keychain"
      )
    end

    if ENV["MATCH_GIT_URL"] && !ENV["MATCH_GIT_URL"].empty?
      match(type: "appstore", readonly: true)
    elsif api_key
      get_provisioning_profile(api_key: api_key, app_identifier: "com.kivowebb.app")
    end

    if ENV["APPLE_TEAM_ID"] && !ENV["APPLE_TEAM_ID"].empty?
      update_project_team(
        path: "Runner.xcodeproj",
        teamid: ENV["APPLE_TEAM_ID"]
      )
    elsif ENV["sigh_com.kivowebb.app_appstore_team_id"]
      update_project_team(
        path: "Runner.xcodeproj",
        teamid: ENV["sigh_com.kivowebb.app_appstore_team_id"]
      )
    end

    profile_path = lane_context[SharedValues::SIGH_PROFILE_PATH] || ENV["sigh_com.kivowebb.app_appstore_profile_path"]
    profile_name = lane_context[SharedValues::SIGH_NAME] || ENV["sigh_com.kivowebb.app_appstore_profile_name"]
    profile_uuid = lane_context[SharedValues::SIGH_UDID] || ENV["sigh_com.kivowebb.app_appstore_uuid"]

    if profile_path && File.exist?(profile_path)
      dest_dir = File.expand_path("~/Library/MobileDevice/Provisioning Profiles")
      FileUtils.mkdir_p(dest_dir)
      FileUtils.cp(profile_path, File.join(dest_dir, "#{profile_uuid}.mobileprovision")) if profile_uuid
      FileUtils.cp(profile_path, File.join(dest_dir, "profile.mobileprovision"))
    end

    team_id = ENV["APPLE_TEAM_ID"] || "Z5W8VPPS7U"

    if profile_name
      update_code_signing_settings(
        use_automatic_signing: false,
        path: "Runner.xcodeproj",
        team_id: team_id,
        bundle_identifier: "com.kivowebb.app",
        profile_name: profile_name,
        code_sign_identity: "Apple Distribution"
      )
    end

    export_opts = {
      method: "app-store"
    }
    if profile_name
      export_opts[:provisioningProfiles] = {
        "com.kivowebb.app" => profile_name
      }
    end

    xcargs_opts = "DEVELOPMENT_TEAM=#{team_id} CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution'"
    if profile_name
      xcargs_opts += " PROVISIONING_PROFILE_SPECIFIER='#{profile_name}'"
    end
    if profile_uuid
      xcargs_opts += " PROVISIONING_PROFILE='#{profile_uuid}'"
    end

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: export_opts,
      xcargs: xcargs_opts
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end
end
