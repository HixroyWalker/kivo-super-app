default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Ensure dependencies are up to date
    cocoapods(clean_install: true)

    # Strip -G flag from all generated pod xcconfig files
    Dir.glob("Pods/**/*.xcconfig").each do |file|
      text = File.read(file)
      if text.include?("-G")
        File.write(file, text.gsub(/-G(\s+|$)/, ' '))
      end
    end

    # Fetch Code Signing Certificates via Match
    match(type: "appstore", readonly: true)

    # Build the Flutter app for iOS
    sh("cd .. && flutter build ios --release --no-codesign")

    # Forcefully strip -Werror and -G from all generated pod xcconfig files right before archive
    Dir.glob("Pods/**/*.xcconfig").each do |file|
      text = File.read(file)
      new_text = text.gsub(/-Werror(\\S*)/, ' ').gsub(/-G(\\s+|$)/, ' ')
      if text != new_text
        File.write(file, new_text)
      end
    end

    # Nuke -Werror from the pbxproj files directly!
    Dir.glob("Pods/**/*.pbxproj").each do |file|
      text = File.read(file)
      new_text = text.gsub(/-Werror(\\S*)/, ' ')
      if text != new_text
        File.write(file, new_text)
      end
    end

    # Wrap Firebase imports in all Flutter Firebase plugins with pragma diagnostic ignores to bypass Xcode 16 Explicit Module non-modular header errors
    sh("find ios/.symlinks/plugins/firebase_* -name '*.h' -type f -exec sed -i '' 's/#import <Firebase\\/Firebase.h>/#pragma clang diagnostic push\\n#pragma clang diagnostic ignored \"-Wnon-modular-include-in-framework-module\"\\n#import <Firebase\\/Firebase.h>\\n#pragma clang diagnostic pop/g' {} + || true")

    # Build the Xcode archive
    build_app(
      workspace: "ios/Runner.xcworkspace",
      scheme: "Runner",
      export_method: "app-store",
      xcargs: "CLANG_ALLOW_NON_MODULAR_INCLUDES_IN_FRAMEWORK_MODULES=YES CLANG_WARN_NON_MODULAR_INCLUDE_IN_FRAMEWORK_MODULE=NO GCC_TREAT_WARNINGS_AS_ERRORS=NO"
    )

    # Upload to TestFlight
    upload_to_testflight(skip_waiting_for_build_processing: true)
  end

  desc "Push a new release build to the App Store"
  lane :release do
    beta # Build and upload to TestFlight first
    upload_to_app_store(force: true)
  end
end

platform :android do
  desc "Push a new beta build to Google Play Internal Track"
  lane :beta do
    # Build the Flutter app for Android (App Bundle)
    sh("cd .. && flutter build appbundle --release")

    # Upload to Google Play Internal Track
    upload_to_play_store(
      track: 'internal',
      aab: '../build/app/outputs/bundle/release/app-release.aab'
    )
  end

  desc "Promote Internal build to Production"
  lane :release do
    upload_to_play_store(
      track: 'internal',
      track_promote_to: 'production'
    )
  end
end
